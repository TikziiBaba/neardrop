# ==============================================================================
# NearDrop Web Environment Configuration
# ==============================================================================

# --- SUPABASE CONFIGURATION (Client-Safe) ---
# Project Settings > API sayfasından alabilirsiniz
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- SUPABASE SERVICE ROLE (Server-Only, Asla istemciye sızdırılmaz) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- CLOUDFLARE R2 STORAGE (Server-Only) ---
# Cloudflare Dashboard > R2 > Manage R2 API Tokens sayfasından oluşturabilirsiniz
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=neardrop-files
