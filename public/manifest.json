  "share_target": {
    "action": "/dashboard",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_files",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Upload Files",
      "short_name": "Upload",
      "url": "/files",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Direct Transfer",
      "short_name": "Transfer",
      "url": "/transfers",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
    }
  ]
