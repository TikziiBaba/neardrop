{
  "name": "NearDrop — Secure File Sharing",
  "short_name": "NearDrop",
  "description": "Fast, private, and secure file sharing. Direct LAN transfers and encrypted cloud storage.",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#0ea5e9",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "lang": "en",
